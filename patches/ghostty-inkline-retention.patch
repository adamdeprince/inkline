+    /// Reclaim images outside the current viewport before the hard budget
+    /// is exhausted. Visible images and unresolved placeholder/relative chains
+    /// are retained; the protocol's existing hard-limit eviction is the fallback.
+    pub fn reclaimOffscreen(
+        self: *ImageStorage,
+        io: std.Io,
+        alloc: Allocator,
+        t: *terminal.Terminal,
+        screen: *terminal.Screen,
+        pressure: bool,
+    ) void {
+        self.reapGarbagePlacements(io, screen);
+        if (!pressure and self.total_bytes < self.total_limit - self.total_limit / 4) return;
+        const target = if (pressure) 0 else self.total_limit / 2;
+        while (self.total_bytes > target) {
+            var candidate: ?*Image = null;
+            var images = self.images.iterator();
+            images: while (images.next()) |entry| {
+                const img = entry.value_ptr;
+                if (self.loading) |loading| {
+                    if (loading.image.id == img.id) continue;
+                }
+                if (img.data == .pending) continue;
+                var placements = self.placements.iterator();
+                while (placements.next()) |placement| {
+                    const p = placement.value_ptr;
+                    // A visible child may depend on an off-screen parent.
+                    if (p.location == .relative and p.location.relative.parent.image_id == img.id) continue :images;
+                    if (placement.key_ptr.image_id != img.id) continue;
+                    if (p.location != .pin) continue :images;
+                    if (screen != t.screens.active) continue;
+                    const rect = p.rect(img.*, t) orelse continue;
+                    const top = screen.pages.pointFromPin(.screen, rect.top_left) orelse continue;
+                    const bottom = screen.pages.pointFromPin(.screen, rect.bottom_right) orelse continue;
+                    const viewport = screen.pages.pin(.{ .viewport = .{} }).?;
+                    const origin = screen.pages.pointFromPin(.screen, viewport).?.screen.y;
+                    if (bottom.screen.y >= origin and top.screen.y < origin + screen.pages.rows) continue :images;
+                }
+                if (candidate == null or img.generation < candidate.?.generation) candidate = img;
+            }
+            const img = candidate orelse break;
