+
+/// Inkline's exact history cap and RAM-pressure maintenance. Called only
+/// between parser operations; it must not synthesize input into a partial APC.
+pub fn inkline_maintain(
+    terminal_: Terminal,
+    max_lines: usize,
+    memory_pressure: bool,
+) callconv(lib.calling_conv) void {
+    const wrapper = terminal_ orelse return;
+    const t = wrapper.terminal;
+    var screens = t.screens.all.iterator();
+    while (screens.next()) |entry| {
+        const screen = entry.value.*;
+        const history = screen.pages.total_rows - screen.pages.rows;
+        if (history > max_lines) {
+            const excess = history - max_lines;
+            // eraseHistory normally moves deleted references to the next row.
+            // Mark discarded content first, so images/selections never migrate
+            // onto unrelated text at the new beginning of history.
+            for (screen.pages.tracked_pins.keys()) |pin| {
+                const pos = screen.pages.pointFromPin(.screen, pin.*) orelse continue;
+                if (pos.screen.y < excess) pin.garbage = true;
+            }
+            screen.pages.viewport_pin.garbage = false;
+            if (screen.selection) |selection| {
+                const bounds = selection.bounds.tracked;
+                if (bounds.start.garbage or bounds.end.garbage) screen.clearSelection();
+            }
+            screen.eraseHistory(.{ .history = .{ .y = @intCast(excess - 1) } });
+        }
+        if (comptime build_options.kitty_graphics) {
+            screen.kitty_images.reclaimOffscreen(wrapper.io.io(), screen.alloc, t, screen, memory_pressure);
+        }
+    }
 }
 
