[Unit]
Description=Inkline Tailscale (userspace networking)
After=network.target

[Service]
Type=simple
RuntimeDirectory=inkline-tailscale
RuntimeDirectoryMode=0700
Environment=HOME=/home/root
Environment=TMPDIR=/run/inkline-tailscale
Environment=XDG_CACHE_HOME=/run/inkline-tailscale
Environment=TS_LOGS_DIR=/run/inkline-tailscale
Environment=TS_NO_LOGS_NO_SUPPORT=true
Environment=TS_DISABLE_TAILDROP=true
ExecStart=/home/root/.local/share/inkline-utilities/tailscale/current/libexec/tailscaled --tun=userspace-networking --state=/home/root/.local/share/inkline-utilities/tailscale/state/tailscaled.state --statedir=/home/root/.local/share/inkline-utilities/tailscale/state --socket=/run/inkline-tailscale/tailscaled.sock --socks5-server=127.0.0.1:1055 --outbound-http-proxy-listen=127.0.0.1:1055 --no-logs-no-support
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
LimitCORE=0
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
