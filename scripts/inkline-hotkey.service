[Unit]
Description=Inkline on-device keyboard launcher
After=systemd-udevd.service

[Service]
Type=simple
RuntimeDirectory=inkline-shortcuts
RuntimeDirectoryMode=0700
ExecStart=/home/root/.local/share/inkline/current/inkline-hotkey
Restart=on-failure
RestartSec=3
LimitCORE=0
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
